{
  "name": "friends-battery-workspace",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": ".\\dev.bat",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && flutter run --dart-define=ENV_FILE=.env.local",
    "gen": ".\\generate_api.bat",
    "build-models": "cd frontend/lib/api && dart pub get && dart run build_runner build --delete-conflicting-outputs",
    "tunnel": "node scripts/tunnel.js",
    "backend": ".\\dev-tunnel.bat",
    "build-prod": "cd frontend && flutter build apk --release --split-per-abi --dart-define=ENV_FILE=.env.production",
    "build-local": "cd frontend && flutter build apk --release --split-per-abi --dart-define=ENV_FILE=.env.local",
    "shorebird:release:prod": ".\\shorebird.bat release prod",
    "shorebird:release:dev": ".\\shorebird.bat release dev",
    "shorebird:patch:prod": ".\\shorebird.bat patch prod",
    "shorebird:patch:dev": ".\\shorebird.bat patch dev",
    "migrate-prod": "cd backend && node scripts/migrate-prod.js",
    "fresh": ".\\fresh.bat",
    "changeset": "changeset",
    "release": "node scripts/version-release.js",
    "changelog:release": "node scripts/version-release.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@ngrok/ngrok": "^1.7.0"
  }
}
