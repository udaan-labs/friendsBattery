datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SELLER
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum UnitStatus {
  AVAILABLE
  IN_SHIPMENT
  SOLD
  RETURNED
  DEFECTIVE
}

enum TransactionAction {
  RECEIVED
  SHIPPED
  SOLD
  RETURNED
  TRANSFERRED
}

model User {
  id           BigInt   @id @default(autoincrement())
  userId       String   @unique @map("user_id") @db.VarChar(50)
  userName     String   @map("user_name") @db.VarChar(100)
  role         Role
  userNumber   String?  @unique @map("user_number") @db.VarChar(20)
  shopName     String?  @map("shop_name") @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.Text
  loginAttempt Int      @default(0) @map("login_attempt")
  isActive     Boolean  @default(true) @map("is_active")
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  // Relations
  ownedUnits             ProductUnit[]          @relation("UnitOwner")
  transactionsFrom       InventoryTransaction[] @relation("TransactionFromUser")
  transactionsTo         InventoryTransaction[] @relation("TransactionToUser")
  stockRequestsMade      StockRequest[]         @relation("StockRequestSeller")
  stockRequestsReceived  StockRequest[]         @relation("StockRequestToUser")
  shipmentsSent          Shipment[]             @relation("ShipmentFromUser")
  shipmentsReceived      Shipment[]             @relation("ShipmentToUser")
  adminShipmentsSent     NewShipment[]          @relation("AdminShipmentSent")
  adminShipmentsReceived NewShipment[]          @relation("AdminShipmentReceived")
  sales                  SalesTransaction[]     @relation("SalesSeller")
  returnsBy              ReturnProduct[]        @relation("ReturnByUser")
  returnsTo              ReturnProduct[]        @relation("ReturnToUser")

  @@map("users")
}

model Customer {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()

  sales SalesTransaction[]

  @@map("customers")
}

model ProductName {
  id   BigInt @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  products         Product[]
  productModels    ProductModel[]
  newShipmentItems NewShipmentItem[]

  @@map("product_names")
}

model ProductModel {
  id            BigInt @id @default(autoincrement())
  productNameId BigInt @map("product_name_id")
  name          String @db.VarChar(100)

  productName      ProductName       @relation(fields: [productNameId], references: [id])
  products         Product[]
  newShipmentItems NewShipmentItem[]

  @@unique([productNameId, name])
  @@map("product_models")
}

model Product {
  id                 BigInt   @id @default(autoincrement())
  productNameId      BigInt   @map("product_name_id")
  productModelId     BigInt   @map("product_model_id")
  minPrice           Decimal  @map("min_price") @db.Decimal(12, 2)
  onSale             Boolean  @default(false) @map("on_sale")
  offerPrice         Decimal? @map("offer_price") @db.Decimal(12, 2)
  stockQuantity      Int      @default(0) @map("stock_quantity")
  minUnitCountAdmin  Int      @default(0) @map("min_unit_count_admin")
  minUnitCountSeller Int      @default(0) @map("min_unit_count_seller")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  productName  ProductName  @relation(fields: [productNameId], references: [id])
  productModel ProductModel @relation(fields: [productModelId], references: [id])

  units             ProductUnit[]
  stockRequestItems StockRequestItem[]
  salesTransactions SalesTransaction[] @relation("ProductSold")
  replacedInSales   SalesTransaction[] @relation("ProductReplaced")
  returns           ReturnProduct[]
  shipmentItems     ShipmentItem[]
  newShipmentItems  NewShipmentItem[]

  @@map("products")
}

model ProductUnit {
  id           BigInt     @id @default(autoincrement())
  productId    BigInt     @map("product_id")
  ownerId      BigInt     @map("owner_id")
  ownerType    Role       @default(ADMIN) @map("owner_type")
  serialNumber String     @unique @map("serial_number") @db.VarChar(100)
  qrCode       String?    @unique @map("qr_code") @db.VarChar(100)
  status       UnitStatus @default(AVAILABLE)
  soldDate     DateTime?  @map("sold_date") @db.Timestamp()
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  product Product @relation(fields: [productId], references: [id])
  owner   User    @relation("UnitOwner", fields: [ownerId], references: [id])

  transactions     InventoryTransaction[]
  sales            SalesTransaction[]
  newShipmentItems NewShipmentItem[]

  @@index([ownerId])
  @@index([productId])
  @@index([status])
  @@index([ownerId, status])
  @@index([productId, ownerId, status])
  @@map("product_units")
}

model InventoryTransaction {
  id            BigInt            @id @default(autoincrement())
  productUnitId BigInt            @map("product_unit_id")
  fromUserId    BigInt?           @map("from_user_id")
  toUserId      BigInt            @map("to_user_id")
  action        TransactionAction
  timestamp     DateTime          @default(now()) @db.Timestamp()

  productUnit ProductUnit @relation(fields: [productUnitId], references: [id])
  fromUser    User?       @relation("TransactionFromUser", fields: [fromUserId], references: [id])
  toUser      User        @relation("TransactionToUser", fields: [toUserId], references: [id])

  @@index([productUnitId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("inventory_transactions")
}

model StockRequest {
  id         BigInt      @id @default(autoincrement())
  sellerId   BigInt      @map("seller_id")
  requestTo  BigInt      @map("request_to")
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamp()
  approvedAt DateTime?   @map("approved_at") @db.Timestamp()

  seller   User               @relation("StockRequestSeller", fields: [sellerId], references: [id])
  receiver User               @relation("StockRequestToUser", fields: [requestTo], references: [id])
  items    StockRequestItem[]

  @@map("stock_requests")
}

model StockRequestItem {
  id                BigInt @id @default(autoincrement())
  stockRequestId    BigInt @map("stock_request_id")
  productId         BigInt @map("product_id")
  requestedQuantity Int    @map("requested_quantity")

  request StockRequest @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@map("stock_request_items")
}

model Shipment {
  id                   BigInt      @id @default(autoincrement())
  fromUserId           BigInt      @map("from_user_id")
  toUserId             BigInt      @map("to_user_id")
  totalProductsShipped Int         @default(0) @map("total_products_shipped")
  shipmentPrice        Decimal     @default(0) @map("shipment_price") @db.Decimal(12, 2)
  status               OrderStatus @default(PENDING)
  shippedOn            DateTime?   @map("shipped_on") @db.Timestamp()
  deliveredOn          DateTime?   @map("delivered_on") @db.Timestamp()
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamp()

  fromUser User           @relation("ShipmentFromUser", fields: [fromUserId], references: [id])
  toUser   User           @relation("ShipmentToUser", fields: [toUserId], references: [id])
  items    ShipmentItem[]

  @@map("transfers")
}

model ShipmentItem {
  id                  BigInt   @id @default(autoincrement())
  shipmentId          BigInt   @map("shipment_id")
  productId           BigInt   @map("product_id")
  quantity            Int
  pricePerPiece       Decimal? @map("price_per_piece") @db.Decimal(12, 2)
  isShipmentRequested Boolean  @default(false) @map("is_shipment_requested")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("transfer_items")
}

enum ShipmentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model NewShipment {
  id               BigInt         @id @default(autoincrement())
  shipmentNumber   String         @unique @map("shipment_number") @db.VarChar(100)
  sellerId         BigInt         @map("seller_id")
  createdByAdminId BigInt         @map("created_by_admin_id")
  status           ShipmentStatus @default(PENDING)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamp()
  acceptedAt       DateTime?      @map("accepted_at") @db.Timestamp()

  seller User @relation("AdminShipmentReceived", fields: [sellerId], references: [id])
  admin  User @relation("AdminShipmentSent", fields: [createdByAdminId], references: [id])

  items NewShipmentItem[]

  @@index([sellerId])
  @@index([createdByAdminId])
  @@index([status])
  @@map("shipments")
}

model NewShipmentItem {
  id            BigInt @id @default(autoincrement())
  shipmentId    BigInt @map("shipment_id")
  productNameId BigInt @map("product_name_id")
  productModelId BigInt @map("product_model_id")
  productId     BigInt @map("product_id")
  productUnitId BigInt @map("product_item_id")
  quantity      Int

  shipment    NewShipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  name        ProductName  @relation(fields: [productNameId], references: [id])
  model       ProductModel @relation(fields: [productModelId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  productUnit ProductUnit  @relation(fields: [productUnitId], references: [id])

  @@index([shipmentId])
  @@index([productId])
  @@index([productUnitId])
  @@map("shipment_items")
}

model SalesTransaction {
  id                BigInt   @id @default(autoincrement())
  productId         BigInt   @map("product_id")
  customerId        BigInt?  @map("customer_id")
  sellerId          BigInt   @map("seller_id")
  productUnitId     BigInt   @map("product_unit_id")
  sellPrice         Decimal  @map("sell_price") @db.Decimal(12, 2)
  serialNumber      String?  @map("serial_number") @db.VarChar(100)
  vehicleNumber     String?  @map("vehicle_number") @db.VarChar(50)
  productReplacedId BigInt?  @map("product_replaced_id")
  soldAt            DateTime @default(now()) @map("sold_at") @db.Timestamp()

  productUnit ProductUnit @relation(fields: [productUnitId], references: [id])

  product         Product         @relation("ProductSold", fields: [productId], references: [id])
  customer        Customer?       @relation(fields: [customerId], references: [id])
  seller          User            @relation("SalesSeller", fields: [sellerId], references: [id])
  productReplaced Product?        @relation("ProductReplaced", fields: [productReplacedId], references: [id])
  returns         ReturnProduct[]

  @@index([soldAt])
  @@index([sellerId, soldAt])
  @@map("sales_transactions")
}

model ReturnProduct {
  id            BigInt   @id @default(autoincrement())
  transactionId BigInt?  @map("transaction_id")
  productId     BigInt?  @map("product_id")
  serialNumber  String?  @map("serial_number") @db.VarChar(100)
  reason        String?  @db.Text
  returnType    String?  @map("return_type") @db.VarChar(50)
  returnById    BigInt?  @map("return_by")
  returnToId    BigInt?  @map("return_to")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp()

  transaction SalesTransaction? @relation(fields: [transactionId], references: [id])
  product     Product?          @relation(fields: [productId], references: [id])
  returnBy    User?             @relation("ReturnByUser", fields: [returnById], references: [id])
  returnTo    User?             @relation("ReturnToUser", fields: [returnToId], references: [id])

  @@map("return_products")
}
