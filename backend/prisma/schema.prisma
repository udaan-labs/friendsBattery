datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  SELLER
}

enum ProductUnitStatus {
  IN_WAREHOUSE
  AT_SHOP
  SOLD
  RETURNED
  UNDER_INSPECTION
  REPLACED
  SCRAPPED
}

enum OwnerType {
  WHOLESALER
  SHOP
  CUSTOMER
}

enum TransactionType {
  RECEIVED
  TRANSFERRED
  SOLD
  RETURNED
  REPLACED
  SCRAPPED
}

enum StockRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnStatus {
  PENDING
  UNDER_INSPECTION
  APPROVED
  REJECTED
  REPLACED
  REPAIRED
  SCRAPPED
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String    @unique
  password_hash String
  role          UserRole
  shop_id       String?   @db.Uuid
  created_at    DateTime? @default(now()) @db.Timestamptz()
  updated_at    DateTime? @default(now()) @db.Timestamptz()

  shop                        Shop?                @relation(fields: [shop_id], references: [id])
  performed_transactions      InventoryTransaction[] @relation("PerformedTransactions")
  sales                       Sale[]
  requested_stock_requests    StockRequest[]       @relation("RequestedStockRequests")
  reviewed_stock_requests     StockRequest[]       @relation("ReviewedStockRequests")
  audit_logs                  AuditLog[]

  @@map("users")
}

model Shop {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopName   String    @map("shop_name")
  ownerName  String    @map("owner_name")
  mobile     String
  address    String
  created_at DateTime? @default(now()) @db.Timestamptz()
  updated_at DateTime? @default(now()) @db.Timestamptz()

  users          User[]
  sales                     Sale[]
  stock_requests            StockRequest[]
  inventory_aggregates      ShopInventoryAggregate[]

  @@map("shops")
}

model ProductGroup {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  created_at DateTime? @default(now()) @db.Timestamptz()

  subgroups ProductSubgroup[]

  @@map("product_groups")
}

model ProductSubgroup {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_group_id String    @db.Uuid
  name             String
  created_at       DateTime? @default(now()) @db.Timestamptz()

  group          ProductGroup   @relation(fields: [product_group_id], references: [id])
  products       Product[]

  @@map("product_subgroups")
}

model Product {
  id                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_subgroup_id       String                   @db.Uuid
  brandName                 String                   @map("brand_name")
  modelName                 String                   @map("model_name")
  capacity                  String
  warrantyMonths            Int                      @map("warranty_months")
  minimum_selling_price     Decimal                  @db.Decimal(10, 2)
  is_serialized             Boolean                  @default(true)
  created_at                DateTime?                @default(now()) @db.Timestamptz()
  updated_at                DateTime?                @default(now()) @db.Timestamptz()

  product_subgroup          ProductSubgroup          @relation(fields: [product_subgroup_id], references: [id])
  product_units             ProductUnit[]
  stock_request_items       StockRequestItem[]
  shop_inventory_aggregates ShopInventoryAggregate[]
  inventoryTransactions     InventoryTransaction[]
  sales                     Sale[]

  @@map("products")
}

model ProductUnit {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serial_number       String             @unique
  product_id          String             @db.Uuid
  manufacturingDate   DateTime?          @map("manufacturing_date") @db.Date
  receivedDate        DateTime?          @default(now()) @map("received_date") @db.Timestamptz()
  status              ProductUnitStatus  @default(IN_WAREHOUSE)
  current_owner_type  OwnerType
  current_owner_id    String?            @db.Uuid
  created_at          DateTime?          @default(now()) @db.Timestamptz()
  updated_at          DateTime?          @default(now()) @db.Timestamptz()

  product               Product                @relation(fields: [product_id], references: [id])
  inventoryTransactions InventoryTransaction[]
  sale                  Sale?
  returns               Return[]
  old_replacements      Replacement[]          @relation("OldReplacement")
  new_replacements      Replacement[]          @relation("NewReplacement")

  @@index([serial_number])
  @@index([status, current_owner_id])
  @@map("product_units")
}

model InventoryTransaction {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_unit_id      String?         @db.Uuid
  product_id           String?         @db.Uuid
  quantity             Int             @default(1)
  transaction_type     TransactionType
  from_owner_type      OwnerType
  from_owner_id        String?         @db.Uuid
  to_owner_type        OwnerType
  to_owner_id          String?         @db.Uuid
  performed_by_user_id String          @db.Uuid
  notes                String?
  created_at           DateTime?       @default(now()) @db.Timestamptz()

  product_unit ProductUnit? @relation(fields: [product_unit_id], references: [id])
  product      Product?     @relation(fields: [product_id], references: [id])
  performed_by User         @relation("PerformedTransactions", fields: [performed_by_user_id], references: [id])

  @@index([product_unit_id])
  @@map("inventory_transactions")
}

model Sale {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_unit_id   String?   @unique @db.Uuid
  product_id        String?   @db.Uuid
  quantity          Int       @default(1)
  customer_id       String    @db.Uuid
  shop_id           String    @db.Uuid
  sold_by_user_id   String    @db.Uuid
  sale_price        Decimal   @db.Decimal
  sale_date         DateTime? @default(now()) @db.Timestamptz()

  product_unit ProductUnit? @relation(fields: [product_unit_id], references: [id])
  product      Product?     @relation(fields: [product_id], references: [id])
  customer     Customer    @relation(fields: [customer_id], references: [id])
  shop         Shop        @relation(fields: [shop_id], references: [id])
  sold_by      User        @relation(fields: [sold_by_user_id], references: [id])
  returns      Return[]

  @@index([shop_id])
  @@map("sales")
}

model StockRequest {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shop_id              String             @db.Uuid
  status               StockRequestStatus @default(PENDING)
  requested_by_user_id String             @db.Uuid
  reviewed_by_user_id  String?            @db.Uuid
  created_at           DateTime?          @default(now()) @db.Timestamptz()
  updated_at           DateTime?          @default(now()) @db.Timestamptz()

  shop         Shop               @relation(fields: [shop_id], references: [id])
  requested_by User               @relation("RequestedStockRequests", fields: [requested_by_user_id], references: [id])
  reviewed_by  User?              @relation("ReviewedStockRequests", fields: [reviewed_by_user_id], references: [id])
  items        StockRequestItem[]

  @@map("stock_requests")
}

model StockRequestItem {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stock_request_id   String    @db.Uuid
  product_id         String    @db.Uuid
  requested_quantity Int
  created_at         DateTime? @default(now()) @db.Timestamptz()

  stock_request StockRequest @relation(fields: [stock_request_id], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [product_id], references: [id])

  @@map("stock_request_items")
}

model Customer {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName      String    @map("full_name")
  mobile        String    @unique
  vehicleNumber String?   @map("vehicle_number")
  address       String?
  created_at    DateTime? @default(now()) @db.Timestamptz()
  updated_at    DateTime? @default(now()) @db.Timestamptz()

  sales         Sale[]

  @@map("customers")
}

model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  entity_name String
  entity_id   String
  action      String
  old_data    Json?
  new_data    Json?
  created_at  DateTime? @default(now()) @db.Timestamptz()

  user User? @relation(fields: [user_id], references: [id])

  @@index([entity_name, entity_id])
  @@index([action])
  @@map("audit_logs")
}

model ShopInventoryAggregate {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shop_id    String    @db.Uuid
  product_id String    @db.Uuid
  quantity   Int       @default(0)
  updated_at DateTime? @default(now()) @db.Timestamptz()

  shop    Shop    @relation(fields: [shop_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@unique([shop_id, product_id])
  @@map("shop_inventory_aggregates")
}

model Return {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sale_id         String       @db.Uuid
  product_unit_id String       @db.Uuid
  return_reason   String
  status          ReturnStatus @default(PENDING)
  created_at      DateTime?    @default(now()) @db.Timestamptz()
  updated_at      DateTime?    @default(now()) @db.Timestamptz()

  sale         Sale         @relation(fields: [sale_id], references: [id])
  product_unit ProductUnit  @relation(fields: [product_unit_id], references: [id])
  replacement  Replacement?

  @@map("returns")
}

model Replacement {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  return_id           String    @unique @db.Uuid
  old_product_unit_id String    @db.Uuid
  new_product_unit_id String    @db.Uuid
  created_at          DateTime? @default(now()) @db.Timestamptz()

  return_request   Return      @relation(fields: [return_id], references: [id])
  old_product_unit ProductUnit @relation("OldReplacement", fields: [old_product_unit_id], references: [id])
  new_product_unit ProductUnit @relation("NewReplacement", fields: [new_product_unit_id], references: [id])

  @@map("replacements")
}
